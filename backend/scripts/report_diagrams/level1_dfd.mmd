    P3 -- "Geocode Address" --> OSM

    U -- "Search Query + Filters" --> P4
    P4 -- "Filtered Results" --> U
    P4 --> DB

    U -- "View Listing" --> P5
    P5 -- "Recommendations" --> U
    P5 --> DB

    U -- "Property Features" --> P6
    P6 -- "Price Request" --> ML
    ML -- "Prediction" --> P6
    P6 -- "Predicted Price" --> U

    U -- "Profile Questionnaire" --> P7
    P7 -- "Compatible Matches" --> U
    P7 --> DB

    A -- "Moderation, Analytics" --> P8
    P8 --> DB
    P8 -- "Reports, Queue" --> A

    U -- "Workplace Address" --> P9
    P9 -- "Commute Score" --> U
    P9 --> OSM

    P2 -- "New Inquiry Event" --> P10
    P10 -- "Real-time Alert" --> U

