    subgraph EstateXAi System
        P1["1.0<br/>Authentication<br/>Module"]
        P2["2.0<br/>Property<br/>Management"]
        P3["3.0<br/>PG & Hostel<br/>Management"]
        P4["4.0<br/>Search &<br/>Filter Engine"]
        P5["5.0<br/>Recommendation<br/>Engine"]
        P6["6.0<br/>Price Prediction<br/>Module"]
        P7["7.0<br/>Roommate<br/>Matching"]
        P8["8.0<br/>Admin<br/>Dashboard"]
        P9["9.0<br/>Commute &<br/>Location Intel"]
        P10["10.0<br/>Notification<br/>Service"]
